{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    // node16, deliberately: this is what Vercel compiles the functions with. The
    // first version of this file used "bundler", which type-checked clean here
    // and then failed in the build with TS2835 — and Vercel deployed the broken
    // function anyway. A local gate that disagrees with the deploy compiler is
    // not a gate. Relative imports therefore need explicit .js extensions.
    "module": "node16",
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["api"]
}
