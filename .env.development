# Defaults for `npm run dev`: the local Supabase stack from `supabase start`.
# These are Supabase's standard local development keys — identical on every
# machine, valid only against 127.0.0.1, and safe to commit.
#
# Vite precedence is .env.development.local > .env.local > .env.development, so
# if you keep a .env.local pointing at production it wins over this file. Add a
# .env.development.local with these same two values to send the dev server back
# to the local stack.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
